package main

import "gpu"
import "hostmath.tx"
import "time"

// The Tiny Shakespeare model is trained only in Python. This program loads the
// exported weights, checks every final-layer value against the Python
// reference on both the CPU and GPU, then compares the generated text.
//
// The model is small enough to stay resident: the host copy used by the CPU
// path and the device copy used by the GPU path both fit in a few megabytes.

type HostModel struct {
  tokEmb[]float
  posEmb[]float
  ln1G[]float
  ln1B[]float
  wq[]float
  bq[]float
  wk[]float
  bk[]float
  wv[]float
  bv[]float
  wo[]float
  bo[]float
  ln2G[]float
  ln2B[]float
  w1[]float
  b1[]float
  w2[]float
  b2[]float
  lnfG[]float
  lnfB[]float
  wout[]float
  bout[]float
  promptTokens[]int
  expectedPromptLogits[]float
  expectedStepLogits[]float
  expectedTokens[]int
  vocab string
  prompt string
  vocabSize int
  blockSize int
  layers int
  heads int
  width int
  hidden int
  promptLen int
  genLen int
  invWidth float
  attnScale float
  lnEps float
}

type DeviceModel struct {
  tokEmb gpu.Buffer[float]
  posEmb gpu.Buffer[float]
  ln1G gpu.Buffer[float]
  ln1B gpu.Buffer[float]
  wq gpu.Buffer[float]
  bq gpu.Buffer[float]
  wk gpu.Buffer[float]
  bk gpu.Buffer[float]
  wv gpu.Buffer[float]
  bv gpu.Buffer[float]
  wo gpu.Buffer[float]
  bo gpu.Buffer[float]
  ln2G gpu.Buffer[float]
  ln2B gpu.Buffer[float]
  w1 gpu.Buffer[float]
  b1 gpu.Buffer[float]
  w2 gpu.Buffer[float]
  b2 gpu.Buffer[float]
  lnfG gpu.Buffer[float]
  lnfB gpu.Buffer[float]
  wout gpu.Buffer[float]
  bout gpu.Buffer[float]
  vocabSize int
  layers int
  heads int
  width int
  hidden int
}

type CpuScratch struct {
  x[]float
  xn[]float
  q[]float
  k[]float
  v[]float
  attn[]float
  scores[]float
  h[]float
  logits[]float
  tokens[]int
}

type DeviceScratch struct {
  tokens gpu.Buffer[int]
  x gpu.Buffer[float]
  xn gpu.Buffer[float]
  q gpu.Buffer[float]
  k gpu.Buffer[float]
  v gpu.Buffer[float]
  attn gpu.Buffer[float]
  scores gpu.Buffer[float]
  h gpu.Buffer[float]
  logits gpu.Buffer[float]
  hostTokens[]int
  hostLogits[]float
}

type Diff struct {
  outside int
  maxDiff float
  firstIndex int
  firstDiff float
}

type Stats struct {
  outside int
  tokenMismatch int
  promptMismatch int
  maxDiff float
  values int
  failures int
  firstStep int
  firstIndex int
  firstDiff float
}

// ---------------------------------------------------------------------------
// GPU kernels
// ---------------------------------------------------------------------------

kernel func embedK(i int, tokens gpu.Buffer [int], tokEmb gpu.Buffer [float], posEmb gpu.Buffer [float], out gpu.Buffer [float], width int) {
  let t int = i / width
  let d int = i - t * width
  let token int = tokens[t]
  out[i] = tokEmb[token * width + d] + posEmb[t * width + d]
}

kernel func layerNormK(i int, input gpu.Buffer [float], gamma gpu.Buffer [float], beta gpu.Buffer [float], out gpu.Buffer [float], width int, offset int, invWidth float, eps float) {
  let base int = i * width
  let sum float = 0.0
  for let d int = 0; d < width; d = d + 1 {
    sum = sum + input[base + d]
  }
  let mean float = sum * invWidth
  let variance float = 0.0
  for let d int = 0; d < width; d = d + 1 {
    let delta float = input[base + d] - mean
    variance = variance + delta * delta
  }
  let inv float = 1.0 / sqrt(variance *invWidth + eps)
  for let d int = 0; d < width; d = d + 1 {
    out[base + d] = (input[base + d] - mean) * inv * gamma[offset + d] + beta[offset + d]
  }
}

kernel func linearK(i int, input gpu.Buffer [float], weight gpu.Buffer [float], bias gpu.Buffer [float], out gpu.Buffer [float], inDim int, outDim int, weightBase int, biasBase int, relu int) {
  let row int = i / outDim
  let oc int = i - row * outDim
  let sum float = bias[biasBase + oc]
  let inputBase int = row * inDim
  let weightRow int = weightBase + oc * inDim
  for let k int = 0; k < inDim; k = k + 1 {
    sum = sum + weight[weightRow + k] *input[inputBase + k]
  }
  if relu == 1 && sum < 0.0 {
    sum = 0.0
  }
  out[i] = sum
}

kernel func linearAddK(i int, input gpu.Buffer [float], weight gpu.Buffer [float], bias gpu.Buffer [float], out gpu.Buffer [float], inDim int, outDim int, weightBase int, biasBase int) {
  let row int = i / outDim
  let oc int = i - row * outDim
  let sum float = bias[biasBase + oc]
  let inputBase int = row * inDim
  let weightRow int = weightBase + oc * inDim
  for let k int = 0; k < inDim; k = k + 1 {
    sum = sum + weight[weightRow + k] *input[inputBase + k]
  }
  out[i] = out[i] + sum
}

// scoresK computes one element of the lower triangle; the upper triangle is
// never read by the causal softmax.
kernel func scoresK(i int, q gpu.Buffer [float], k gpu.Buffer [float], out gpu.Buffer [float], length int, heads int, width int, scale float) {
  let perHead int = length * length
  let h int = i / perHead
  let rem int = i - h * perHead
  let t int = rem / length
  let keyIdx int = rem - t * length
  if keyIdx <= t {
    let headDim int = width / heads
    let headOffset int = h * headDim
    let qBase int = t * width + headOffset
    let kBase int = keyIdx * width + headOffset
    let sum float = 0.0
    for let d int = 0; d < headDim; d = d + 1 {
      sum = sum + q[qBase + d] *k[kBase + d]
    }
    out[i] = sum * scale
  }
}

kernel func softmaxK(i int, scores gpu.Buffer [float], length int) {
  let h int = i / length
  let t int = i - h * length
  let base int = (h *length + t) * length
  let best float = scores[base]
  for let keyIdx int = 1; keyIdx <= t; keyIdx = keyIdx + 1 {
    if scores[base + keyIdx] > best {
      best = scores[base + keyIdx]
    }
  }
  let sum float = 0.0
  for let keyIdx int = 0; keyIdx <= t; keyIdx = keyIdx + 1 {
    let e float = exp(scores[base + keyIdx] - best)
    scores[base + keyIdx] = e
    sum = sum + e
  }
  let inv float = 1.0 / sum
  for let keyIdx int = 0; keyIdx <= t; keyIdx = keyIdx + 1 {
    scores[base + keyIdx] = scores[base + keyIdx] *inv
  }
}

kernel func weightedK(i int, scores gpu.Buffer [float], v gpu.Buffer [float], out gpu.Buffer [float], length int, heads int, width int) {
  let t int = i / width
  let d int = i - t * width
  let headDim int = width / heads
  let h int = d / headDim
  let base int = (h *length + t) * length
  let sum float = 0.0
  for let keyIdx int = 0; keyIdx <= t; keyIdx = keyIdx + 1 {
    sum = sum + scores[base + keyIdx] *v[keyIdx * width + d]
  }
  out[i] = sum
}

// ---------------------------------------------------------------------------
// CPU helpers
// ---------------------------------------------------------------------------

func findToken(vocab string, ch string) int {
  for let i int = 0; i < len(vocab); i = i + 1 {
    if vocab[i] == ch {
      return i
    }
  }
  return -1
}

func tokenizePrompt(vocab string, prompt string, mut out []int) int {
  for let i int = 0; i < len(prompt); i = i + 1 {
    let id int = findToken(vocab, prompt[i])
    if id < 0 {
      return -1
    }
    out[i] = id
  }
  return len(prompt)
}

func layerNormHost(input []float, gamma []float, beta []float, mut out []float, rows int, width int, offset int, invWidth float, eps float) int {
  for let row int = 0; row < rows; row = row + 1 {
    let base int = row * width
    let sum float = 0.0
    for let d int = 0; d < width; d = d + 1 {
      sum = sum + input[base + d]
    }
    let mean float = sum * invWidth
    let variance float = 0.0
    for let d int = 0; d < width; d = d + 1 {
      let delta float = input[base + d] - mean
      variance = variance + delta * delta
    }
    let inv float = 1.0 / hostmath.hsqrt(variance *invWidth + eps)
    for let d int = 0; d < width; d = d + 1 {
      out[base + d] = (input[base + d] - mean) * inv * gamma[offset + d] + beta[offset + d]
    }
  }
  return 0
}

func linearHost(input []float, weight []float, bias []float, mut out []float, rows int, inDim int, outDim int, weightBase int, biasBase int, relu int) int {
  for let row int = 0; row < rows; row = row + 1 {
    let inputBase int = row * inDim
    let outputBase int = row * outDim
    for let oc int = 0; oc < outDim; oc = oc + 1 {
      let sum float = bias[biasBase + oc]
      let weightRow int = weightBase + oc * inDim
      for let k int = 0; k < inDim; k = k + 1 {
        sum = sum + weight[weightRow + k] *input[inputBase + k]
      }
      if relu == 1 && sum < 0.0 {
        sum = 0.0
      }
      out[outputBase + oc] = sum
    }
  }
  return 0
}

func linearAddHost(input []float, weight []float, bias []float, mut out []float, rows int, inDim int, outDim int, weightBase int, biasBase int) int {
  for let row int = 0; row < rows; row = row + 1 {
    let inputBase int = row * inDim
    let outputBase int = row * outDim
    for let oc int = 0; oc < outDim; oc = oc + 1 {
      let sum float = bias[biasBase + oc]
      let weightRow int = weightBase + oc * inDim
      for let k int = 0; k < inDim; k = k + 1 {
        sum = sum + weight[weightRow + k] *input[inputBase + k]
      }
      out[outputBase + oc] = out[outputBase + oc] + sum
    }
  }
  return 0
}

func softmaxHost(mut scores []float, length int, heads int) int {
  for let h int = 0; h < heads; h = h + 1 {
    for let t int = 0; t < length; t = t + 1 {
      let base int = (h *length + t) * length
      let best float = scores[base]
      for let a int = 1; a <= t; a = a + 1 {
        if scores[base + a] > best {
          best = scores[base + a]
        }
      }
      let sum float = 0.0
      for let b int = 0; b <= t; b = b + 1 {
        let e float = hostmath.hexp(scores[base + b] - best)
        scores[base + b] = e
        sum = sum + e
      }
      let inv float = 1.0 / sum
      for let c int = 0; c <= t; c = c + 1 {
        scores[base + c] = scores[base + c] *inv
      }
    }
  }
  return 0
}

func argmax(values []float, base int, count int) int {
  let bestIndex int = 0
  let best float = values[base]
  for let i int = 1; i < count; i = i + 1 {
    let value float = values[base + i]
    if value > best {
      best = value
      bestIndex = i
    }
  }
  return bestIndex
}

func forwardCpu(m HostModel, s CpuScratch, n int) int {
  let width int = m.width
  let heads int = m.heads
  let headDim int = width / heads
  let hidden int = m.hidden

  for let t int = 0; t < n; t = t + 1 {
    let token int = s.tokens[t]
    let tokenBase int = token * width
    let posBase int = t * width
    for let d int = 0; d < width; d = d + 1 {
      s.x[t * width + d] = m.tokEmb[tokenBase + d] + m.posEmb[posBase + d]
    }
  }

  for let layer int = 0; layer < m.layers; layer = layer + 1 {
    layerNormHost(s.x, m.ln1G, m.ln1B, s.xn, n, width, layer *width, m.invWidth, m.lnEps)
    linearHost(s.xn, m.wq, m.bq, s.q, n, width, width, layer *width *width, layer *width, 0)
    linearHost(s.xn, m.wk, m.bk, s.k, n, width, width, layer *width *width, layer *width, 0)
    linearHost(s.xn, m.wv, m.bv, s.v, n, width, width, layer *width *width, layer *width, 0)

    for let h int = 0; h < heads; h = h + 1 {
      let headOffset int = h * headDim
      for let t int = 0; t < n; t = t + 1 {
        let qBase int = t * width + headOffset
        for let keyIdx int = 0; keyIdx <= t; keyIdx = keyIdx + 1 {
          let kBase int = keyIdx * width + headOffset
          let sum float = 0.0
          for let d int = 0; d < headDim; d = d + 1 {
            sum = sum + s.q[qBase + d] *s.k[kBase + d]
          }
          s.scores[(h *n + t) * n + keyIdx] = sum * m.attnScale
        }
      }
    }

    softmaxHost(s.scores, n, heads)

    for let t int = 0; t < n; t = t + 1 {
      for let d int = 0; d < width; d = d + 1 {
        let h int = d / headDim
        let base int = (h *n + t) * n
        let sum float = 0.0
        for let keyIdx int = 0; keyIdx <= t; keyIdx = keyIdx + 1 {
          sum = sum + s.scores[base + keyIdx] *s.v[keyIdx * width + d]
        }
        s.attn[t * width + d] = sum
      }
    }

    linearAddHost(s.attn, m.wo, m.bo, s.x, n, width, width, layer *width *width, layer *width)
    layerNormHost(s.x, m.ln2G, m.ln2B, s.xn, n, width, layer *width, m.invWidth, m.lnEps)
    linearHost(s.xn, m.w1, m.b1, s.h, n, width, hidden, layer *hidden *width, layer *hidden, 1)
    linearAddHost(s.h, m.w2, m.b2, s.x, n, hidden, width, layer *width *hidden, layer *width)
  }

  layerNormHost(s.x, m.lnfG, m.lnfB, s.xn, n, width, 0, m.invWidth, m.lnEps)
  linearHost(s.xn, m.wout, m.bout, s.logits, n, width, m.vocabSize, 0, 0, 0)
  return 0
}

func forwardGpu(m DeviceModel, s DeviceScratch, h HostModel, n int) int {
  let hostTokens []int = s.hostTokens[0:n]
  gpu.copyToDevice(hostTokens, s.tokens)
  gpu.launch1d(embedK, n *m.width, s.tokens, m.tokEmb, m.posEmb, s.x, m.width)

  for let layer int = 0; layer < m.layers; layer = layer + 1 {
    gpu.launch1d(layerNormK, n, s.x, m.ln1G, m.ln1B, s.xn, m.width, layer *m.width, h.invWidth, h.lnEps)
    gpu.launch1d(linearK, n *m.width, s.xn, m.wq, m.bq, s.q, m.width, m.width, layer *m.width *m.width, layer *m.width, 0)
    gpu.launch1d(linearK, n *m.width, s.xn, m.wk, m.bk, s.k, m.width, m.width, layer *m.width *m.width, layer *m.width, 0)
    gpu.launch1d(linearK, n *m.width, s.xn, m.wv, m.bv, s.v, m.width, m.width, layer *m.width *m.width, layer *m.width, 0)
    gpu.launch1d(scoresK, m.heads *n *n, s.q, s.k, s.scores, n, m.heads, m.width, h.attnScale)
    gpu.launch1d(softmaxK, m.heads *n, s.scores, n)
    gpu.launch1d(weightedK, n *m.width, s.scores, s.v, s.attn, n, m.heads, m.width)
    gpu.launch1d(linearAddK, n *m.width, s.attn, m.wo, m.bo, s.x, m.width, m.width, layer *m.width *m.width, layer *m.width)
    gpu.launch1d(layerNormK, n, s.x, m.ln2G, m.ln2B, s.xn, m.width, layer *m.width, h.invWidth, h.lnEps)
    gpu.launch1d(linearK, n *m.hidden, s.xn, m.w1, m.b1, s.h, m.width, m.hidden, layer *m.hidden *m.width, layer *m.hidden, 1)
    gpu.launch1d(linearAddK, n *m.width, s.h, m.w2, m.b2, s.x, m.hidden, m.width, layer *m.width *m.hidden, layer *m.width)
  }

  gpu.launch1d(layerNormK, n, s.x, m.lnfG, m.lnfB, s.xn, m.width, 0, h.invWidth, h.lnEps)
  gpu.launch1d(linearK, n *m.vocabSize, s.xn, m.wout, m.bout, s.logits, m.width, m.vocabSize, 0, 0, 0)
  return 0
}

func compareValues(actual []float, expected []float, actualBase int, expectedBase int, count int) Diff {
  let outside int = 0
  let maxDiff float = 0.0
  let firstIndex int = -1
  let firstDiff float = 0.0

  for let i int = 0; i < count; i = i + 1 {
    let diff float = actual[actualBase + i] - expected[expectedBase + i]
    if diff < 0.0 {
      diff = 0.0 - diff
    }
    if diff > maxDiff {
      maxDiff = diff
    }
    if diff > 0.000000001 {
      outside = outside + 1
      if firstIndex < 0 {
        firstIndex = i
        firstDiff = diff
      }
    }
  }

  return Diff{outside: outside, maxDiff: maxDiff, firstIndex: firstIndex, firstDiff: firstDiff}
}

func generateCpu(m HostModel, s CpuScratch, check int) Stats {
  let outside int = 0
  let tokenMismatch int = 0
  let promptMismatch int = 0
  let maxDiff float = 0.0
  let firstStep int = -1
  let firstIndex int = -1
  let firstDiff float = 0.0

  let promptCount int = tokenizePrompt(m.vocab, m.prompt, s.tokens)
  if promptCount != m.promptLen{
    print("cpu prompt tokenization failed")
    return Stats{outside: 0, tokenMismatch: 0, promptMismatch: 1, maxDiff: 0.0, values: 0, failures: 1, firstStep: -1, firstIndex: -1, firstDiff: 0.0}
  }

  if check == 1 {
    for let i int = 0; i < m.promptLen; i = i + 1 {
      if s.tokens[i] != m.promptTokens[i]{
        if promptMismatch < 5 {
          print("cpu prompt token ", i, " trux ", s.tokens[i], " python ", m.promptTokens[i])
        }
        promptMismatch = promptMismatch + 1
      }
    }
  }

  let n int = m.promptLen
  forwardCpu(m, s, n)

  if check == 1 {
    let d Diff = compareValues(s.logits, m.expectedPromptLogits, 0, 0, n *m.vocabSize)
    outside = outside + d.outside
    if d.maxDiff > maxDiff {
      maxDiff = d.maxDiff
    }
    if d.outside > 0 && firstIndex < 0 {
      firstIndex = d.firstIndex
      firstDiff = d.firstDiff
    }
  }

  for let step int = 0; step < m.genLen; step = step + 1 {
    let logitBase int = (n - 1) * m.vocabSize

    if check == 1 {
      let d Diff = compareValues(s.logits, m.expectedStepLogits, logitBase, step *m.vocabSize, m.vocabSize)
      outside = outside + d.outside
      if d.maxDiff > maxDiff {
        maxDiff = d.maxDiff
      }
      if d.outside > 0 && firstIndex < 0 {
        firstStep = step
        firstIndex = d.firstIndex
        firstDiff = d.firstDiff
      }
    }

    let id int = argmax(s.logits, logitBase, m.vocabSize)
    if check == 1 && id != m.expectedTokens[step]{
      if tokenMismatch < 5 {
        print("cpu step ", step, " token ", id, " python ", m.expectedTokens[step])
      }
      tokenMismatch = tokenMismatch + 1
    }

    s.tokens[n] = id
    n = n + 1

    if step + 1 < m.genLen{
      forwardCpu(m, s, n)
    }
  }

  let values int = 0
  if check == 1 {
    values = (m.promptLen + m.genLen) * m.vocabSize
  }
  let failures int = outside + tokenMismatch + promptMismatch
  return Stats{outside: outside, tokenMismatch: tokenMismatch, promptMismatch: promptMismatch, maxDiff: maxDiff, values: values, failures: failures, firstStep: firstStep, firstIndex: firstIndex, firstDiff: firstDiff}
}

func generateGpu(m DeviceModel, s DeviceScratch, h HostModel, check int) Stats {
  let outside int = 0
  let tokenMismatch int = 0
  let promptMismatch int = 0
  let maxDiff float = 0.0
  let firstStep int = -1
  let firstIndex int = -1
  let firstDiff float = 0.0

  let promptCount int = tokenizePrompt(h.vocab, h.prompt, s.hostTokens)
  if promptCount != h.promptLen{
    print("gpu prompt tokenization failed")
    return Stats{outside: 0, tokenMismatch: 0, promptMismatch: 1, maxDiff: 0.0, values: 0, failures: 1, firstStep: -1, firstIndex: -1, firstDiff: 0.0}
  }

  if check == 1 {
    for let i int = 0; i < h.promptLen; i = i + 1 {
      if s.hostTokens[i] != h.promptTokens[i]{
        if promptMismatch < 5 {
          print("gpu prompt token ", i, " trux ", s.hostTokens[i], " python ", h.promptTokens[i])
        }
        promptMismatch = promptMismatch + 1
      }
    }
  }

  let n int = h.promptLen
  forwardGpu(m, s, h, n)
  gpu.sync()
  let promptSlice []float = s.hostLogits[0:n * h.vocabSize]
  gpu.to(s.logits, promptSlice)

  if check == 1 {
    let d Diff = compareValues(s.hostLogits, h.expectedPromptLogits, 0, 0, n *h.vocabSize)
    outside = outside + d.outside
    if d.maxDiff > maxDiff {
      maxDiff = d.maxDiff
    }
    if d.outside > 0 && firstIndex < 0 {
      firstIndex = d.firstIndex
      firstDiff = d.firstDiff
    }
  }

  for let step int = 0; step < h.genLen; step = step + 1 {
    let logitBase int = (n - 1) * h.vocabSize

    if check == 1 {
      let d Diff = compareValues(s.hostLogits, h.expectedStepLogits, logitBase, step *h.vocabSize, h.vocabSize)
      outside = outside + d.outside
      if d.maxDiff > maxDiff {
        maxDiff = d.maxDiff
      }
      if d.outside > 0 && firstIndex < 0 {
        firstStep = step
        firstIndex = d.firstIndex
        firstDiff = d.firstDiff
      }
    }

    let id int = argmax(s.hostLogits, logitBase, h.vocabSize)
    if check == 1 && id != h.expectedTokens[step]{
      if tokenMismatch < 5 {
        print("gpu step ", step, " token ", id, " python ", h.expectedTokens[step])
      }
      tokenMismatch = tokenMismatch + 1
    }

    s.hostTokens[n] = id
    n = n + 1

    if step + 1 < h.genLen{
      forwardGpu(m, s, h, n)
      gpu.sync()
      let stepSlice []float = s.hostLogits[0:n * h.vocabSize]
      gpu.to(s.logits, stepSlice)
    }
  }

  let values int = 0
  if check == 1 {
    values = (h.promptLen + h.genLen) * h.vocabSize
  }
  let failures int = outside + tokenMismatch + promptMismatch
  return Stats{outside: outside, tokenMismatch: tokenMismatch, promptMismatch: promptMismatch, maxDiff: maxDiff, values: values, failures: failures, firstStep: firstStep, firstIndex: firstIndex, firstDiff: firstDiff}
}

func decodeTokens(vocab string, tokens []int, start int, count int) string {
  let result string = ""
  for let i int = 0; i < count; i = i + 1 {
    result = result + vocab[tokens[start + i]]
  }
  return result
}

func printStats(label string, s Stats) int {
  print(label, " values checked ", s.values)
  print(label, " values outside 1e-9 ", s.outside)
  print(label, " max logit difference ", s.maxDiff)
  print(label, " token mismatches ", s.tokenMismatch)
  print(label, " prompt token mismatches ", s.promptMismatch)
  if s.firstIndex >= 0 {
    if s.firstStep < 0 {
      print(label, " first mismatch at prompt index ", s.firstIndex, " diff ", s.firstDiff)
    } else {
      print(label, " first mismatch at step ", s.firstStep, " index ", s.firstIndex, " diff ", s.firstDiff)
    }
  }
  return 0
}

func printRatio(label string, cpuNanos int, gpuNanos int) int {
  if gpuNanos <= 0 {
    print(label, " gpu time is zero")
    return 0
  }
  let hundredths int = cpuNanos * 100 / gpuNanos
  let whole int = hundredths / 100
  let fraction int = hundredths - whole * 100
  if fraction < 10 {
    print(label, " ", whole, ".0", fraction, "x")
  } else {
    print(label, " ", whole, ".", fraction, "x")
  }
  return 0
}

func main() int {
  gpu.mount("model.txm")

  let config []int = gpu.hostInts("config")
  if len(config) != 6 {
    print("model config must have 6 values")
    return 1
  }

  let vocabSize int = config[0]
  let blockSize int = config[1]
  let layers int = config[2]
  let heads int = config[3]
  let width int = config[4]
  let hidden int = config[5]

  let vocab string = "\n !$&',-.3:;?ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  let prompt string = "JULIET:\n"
  let promptLen int = gpu.dim("prompt_tokens", 0)
  let genLen int = gpu.dim("expected_tokens", 0)

  if vocabSize != len(vocab) {
    print("vocab size mismatch: model ", vocabSize, " program ", len(vocab))
    return 1
  }
  if promptLen != len(prompt) {
    print("prompt length mismatch: model ", promptLen, " program ", len(prompt))
    return 1
  }
  if layers < 1 || heads < 1 || width < 1 || hidden < 1 || blockSize < 1 {
    print("model dimensions must be positive")
    return 1
  }
  if width % heads != 0 {
    print("width must be divisible by heads")
    return 1
  }
  if promptLen + genLen > blockSize {
    print("prompt plus generated tokens exceed the context")
    return 1
  }
  if gpu.dim("tok_emb", 0) != vocabSize || gpu.dim("tok_emb", 1) != width {
    print("tok_emb shape mismatch")
    return 1
  }
  if gpu.dim("pos_emb", 0) != blockSize || gpu.dim("pos_emb", 1) != width {
    print("pos_emb shape mismatch")
    return 1
  }
  if gpu.dim("w1", 0) != layers || gpu.dim("w1", 1) != hidden || gpu.dim("w1", 2) != width {
    print("w1 shape mismatch")
    return 1
  }
  if gpu.dim("wout", 0) != vocabSize || gpu.dim("wout", 1) != width {
    print("wout shape mismatch")
    return 1
  }
  if gpu.dim("expected_prompt_logits", 0) != promptLen || gpu.dim("expected_prompt_logits", 1) != vocabSize {
    print("expected prompt logits shape mismatch")
    return 1
  }
  if gpu.dim("expected_step_logits", 0) != genLen || gpu.dim("expected_step_logits", 1) != vocabSize {
    print("expected step logits shape mismatch")
    return 1
  }

  let invWidth float = gpu.hostFloats("inv_width")[0]
  let attnScale float = gpu.hostFloats("attn_scale")[0]
  let lnEps float = gpu.hostFloats("ln_eps")[0]
  if invWidth <= 0.0 || attnScale <= 0.0 || lnEps <= 0.0 {
    print("model constants must be positive")
    return 1
  }

  let hm HostModel = HostModel{
    tokEmb: gpu.hostFloats("tok_emb"),
    posEmb: gpu.hostFloats("pos_emb"),
    ln1G: gpu.hostFloats("ln1_g"),
    ln1B: gpu.hostFloats("ln1_b"),
    wq: gpu.hostFloats("wq"),
    bq: gpu.hostFloats("bq"),
    wk: gpu.hostFloats("wk"),
    bk: gpu.hostFloats("bk"),
    wv: gpu.hostFloats("wv"),
    bv: gpu.hostFloats("bv"),
    wo: gpu.hostFloats("wo"),
    bo: gpu.hostFloats("bo"),
    ln2G: gpu.hostFloats("ln2_g"),
    ln2B: gpu.hostFloats("ln2_b"),
    w1: gpu.hostFloats("w1"),
    b1: gpu.hostFloats("b1"),
    w2: gpu.hostFloats("w2"),
    b2: gpu.hostFloats("b2"),
    lnfG: gpu.hostFloats("lnf_g"),
    lnfB: gpu.hostFloats("lnf_b"),
    wout: gpu.hostFloats("wout"),
    bout: gpu.hostFloats("bout"),
    promptTokens: gpu.hostInts("prompt_tokens"),
    expectedPromptLogits: gpu.hostFloats("expected_prompt_logits"),
    expectedStepLogits: gpu.hostFloats("expected_step_logits"),
    expectedTokens: gpu.hostInts("expected_tokens"),
    vocab: vocab,
    prompt: prompt,
    vocabSize: vocabSize,
    blockSize: blockSize,
    layers: layers,
    heads: heads,
    width: width,
    hidden: hidden,
    promptLen: promptLen,
    genLen: genLen,
    invWidth: invWidth,
    attnScale: attnScale,
    lnEps: lnEps,
  }

  let dm DeviceModel = DeviceModel{
    tokEmb: gpu.floats("tok_emb"),
    posEmb: gpu.floats("pos_emb"),
    ln1G: gpu.floats("ln1_g"),
    ln1B: gpu.floats("ln1_b"),
    wq: gpu.floats("wq"),
    bq: gpu.floats("bq"),
    wk: gpu.floats("wk"),
    bk: gpu.floats("bk"),
    wv: gpu.floats("wv"),
    bv: gpu.floats("bv"),
    wo: gpu.floats("wo"),
    bo: gpu.floats("bo"),
    ln2G: gpu.floats("ln2_g"),
    ln2B: gpu.floats("ln2_b"),
    w1: gpu.floats("w1"),
    b1: gpu.floats("b1"),
    w2: gpu.floats("w2"),
    b2: gpu.floats("b2"),
    lnfG: gpu.floats("lnf_g"),
    lnfB: gpu.floats("lnf_b"),
    wout: gpu.floats("wout"),
    bout: gpu.floats("bout"),
    vocabSize: vocabSize,
    layers: layers,
    heads: heads,
    width: width,
    hidden: hidden,
  }

  let cpuScratch CpuScratch = CpuScratch{
    x: make([]float, blockSize *width),
    xn: make([]float, blockSize *width),
    q: make([]float, blockSize *width),
    k: make([]float, blockSize *width),
    v: make([]float, blockSize *width),
    attn: make([]float, blockSize *width),
    scores: make([]float, heads *blockSize *blockSize),
    h: make([]float, blockSize *hidden),
    logits: make([]float, blockSize *vocabSize),
    tokens: make([]int, blockSize),
  }

  let dTokens gpu.Buffer[int] = gpu.alloc(blockSize)
  let dX gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dXn gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dQ gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dK gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dV gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dAttn gpu.Buffer[float] = gpu.alloc(blockSize *width)
  let dScores gpu.Buffer[float] = gpu.alloc(heads *blockSize * blockSize)
  let dH gpu.Buffer[float] = gpu.alloc(blockSize *hidden)
  let dLogits gpu.Buffer[float] = gpu.alloc(blockSize *vocabSize)

  let gpuScratch DeviceScratch = DeviceScratch{
    tokens: dTokens,
    x: dX,
    xn: dXn,
    q: dQ,
    k: dK,
    v: dV,
    attn: dAttn,
    scores: dScores,
    h: dH,
    logits: dLogits,
    hostTokens: make([]int, blockSize),
    hostLogits: make([]float, blockSize *vocabSize),
  }

  // Warm both paths before timing. The CPU loop and the GPU launches execute
  // the same arithmetic in the same order inside each layer.
  generateCpu(hm, cpuScratch, 0)
  let cpuStarted int = time.monotonicNanos()
  let cpuStats Stats = generateCpu(hm, cpuScratch, 1)
  let cpuFinished int = time.monotonicNanos()

  generateGpu(dm, gpuScratch, hm, 0)
  let gpuStarted int = time.monotonicNanos()
  let gpuStats Stats = generateGpu(dm, gpuScratch, hm, 1)
  let gpuFinished int = time.monotonicNanos()

  let cpuText string = prompt + decodeTokens(vocab, cpuScratch.tokens, promptLen, genLen)
  let gpuText string = prompt + decodeTokens(vocab, gpuScratch.hostTokens, promptLen, genLen)
  let expectedText string = prompt + decodeTokens(vocab, hm.expectedTokens, 0, genLen)

  let textMismatch int = 0
  if cpuText != gpuText {
    textMismatch = textMismatch + 1
  }
  if cpuText != expectedText {
    textMismatch = textMismatch + 1
  }

  // One full-context forward measures prefill separately from the
  // autoregressive loop. It includes the token upload and the host copy, the
  // same work the generation loop does for every step.
  let totalLen int = promptLen + genLen
  let cpuPrefillStarted int = time.monotonicNanos()
  forwardCpu(hm, cpuScratch, totalLen)
  let cpuPrefillFinished int = time.monotonicNanos()

  let gpuPrefillStarted int = time.monotonicNanos()
  forwardGpu(dm, gpuScratch, hm, totalLen)
  gpu.sync()
  let gpuPrefillFinished int = time.monotonicNanos()

  let cpuNanos int = cpuFinished - cpuStarted
  let gpuNanos int = gpuFinished - gpuStarted
  let cpuPrefillNanos int = cpuPrefillFinished - cpuPrefillStarted
  let gpuPrefillNanos int = gpuPrefillFinished - gpuPrefillStarted

  print("")
  print("model: layers ", layers, " heads ", heads, " width ", width, " mlp ", hidden, " vocab ", vocabSize, " context ", blockSize)
  print("prompt:")
  print(prompt)
  print("reference text:")
  print(expectedText)
  print("cpu text:")
  print(cpuText)
  print("gpu text:")
  print(gpuText)
  print("")
  printStats("cpu", cpuStats)
  printStats("gpu", gpuStats)
  print("text mismatches ", textMismatch)
  print("")
  print("cpu generation nanos ", cpuNanos)
  print("gpu generation nanos ", gpuNanos)
  print("cpu nanoseconds per token ", cpuNanos / genLen)
  print("gpu nanoseconds per token ", gpuNanos / genLen)
  print("cpu prefill nanos ", cpuPrefillNanos)
  print("gpu prefill nanos ", gpuPrefillNanos)
  printRatio("cpu/gpu generation", cpuNanos, gpuNanos)
  printRatio("cpu/gpu prefill", cpuPrefillNanos, gpuPrefillNanos)

  gpu.free(dTokens)
  gpu.free(dX)
  gpu.free(dXn)
  gpu.free(dQ)
  gpu.free(dK)
  gpu.free(dV)
  gpu.free(dAttn)
  gpu.free(dScores)
  gpu.free(dH)
  gpu.free(dLogits)

  let failures int = cpuStats.failures + gpuStats.failures + textMismatch
  if failures != 0 {
    print("Trux and the Python exporter disagree")
    return 1
  }

  return 0
}
