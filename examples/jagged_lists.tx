package main

type RowSummary struct {
  length int
  total int
}

func summarize(row list[int]) RowSummary {
  let total int = 0
  let i int = 0

  for i < len(row) {
    total = total + row[i]
    i = i + 1
  }

  return RowSummary{length: len(row), total: total}
}

func main() int {
  let rows list[list[int]] = list[list[int]]{list[int]{1, 2}, list[int]{3, 4, 5}, list[int]{}}

  append(rows[0], 9)
  append(rows[2], 6)

  let r0 RowSummary = summarize(rows[0])
  let r1 RowSummary = summarize(rows[1])
  let r2 RowSummary = summarize(rows[2])

  print(r0.length, " ", r1.length, " ", r2.length)
  print(r0.total, " ", r1.total, " ", r2.total)
  return 0
}
