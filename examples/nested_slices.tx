package main

type CellPos struct {
  row int
  col int
}

func cellAt(rows [][]float, pos CellPos) float {
  return rows[pos.row][pos.col]
}

func main() int {
  let rows [][]float = make([][]float, 3)

  rows[0] = make([]float, 1)
  rows[1] = make([]float, 2)
  rows[2] = make([]float, 3)

  rows[0][0] = 1.5
  rows[1][0] = 2.5
  rows[1][1] = 3.5
  rows[2][0] = 4.5
  rows[2][1] = 5.5
  rows[2][2] = 6.5

  let copied [][]float = clone(rows)
  copied[1][0] = 9.5

  let target CellPos = CellPos{row: 1, col: 0}
  print(len(rows[0]), " ", len(rows[1]), " ", len(rows[2]))
  print(cellAt(rows, target), " ", cellAt(copied, target))
  return 0
}
