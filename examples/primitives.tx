package main

func mean(a float, b float) float {
    // Float arithmetic stays separate from int arithmetic. Mixed numeric
    // expressions are rejected instead of implicitly promoting.
    return (a + b) / 2.0
}

func project() string {
    return "trux"
}

func stable() bool {
    return false
}

func main() int {
    let name string = project()
    let isStable bool = stable()
    let count int = 3
    let average float = mean(1.5, 2.5)
    let escaped string = "line\nquote: \""

    // Multi-argument print emits every value on one line, then a newline.
    print(name, " ", count, " ", isStable)
    print(average)
    print(escaped)

    return 0
}
