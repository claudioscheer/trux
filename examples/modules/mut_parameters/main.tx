package main

import "queue.tx"
import "stack.tx"

func main() int {
  // Imported functions can expose `mut` parameters too.
  let items list[int] = list[int]{10}
  print(stack.push(items, 20), " ", items[1])

  let xs [3]int = [3]int{0, 0, 0}
  print(stack.setMiddle(xs, 4), " ", xs[1])
  print(stack.setFirst(xs[:], 7), " ", xs[0])

  let counts map[string]int = make(map[string]int)
  print(stack.bump(counts, "ops"), " ", stack.bump(counts, "ops"))

  // Imported structs can be mutated through pointers across package boundaries.
  let q queue.Queue = queue.Queue{values: list[int]{}, head: 0}
  let firstSize int = queue.enqueue(&q, 10)
  let secondSize int = queue.enqueue(&q, 20)
  print(firstSize, " ", secondSize, " ", queue.queued(&q))
  print(queue.dequeue(&q), " ", queue.dequeue(&q), " ", queue.queued(&q))

  return 0
}
