package main

func main() int {
    let xs list[int] = list[int]{1}
    let alias list[int] = xs

    append(xs, 2)
    print(len(alias), " ", alias[1])

    append(alias, 3)
    xs[0] = xs[0] + 1
    let n int = len(alias)
    print(n, " ", xs[0], " ", xs[2])

    let view []int = xs[1:]
    view[0] = 8
    print(xs[1], " ", len(view))

    return 0
}
