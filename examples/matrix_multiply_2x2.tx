package main

func multiply2x2(left [2][2]int, right [2][2]int) [2][2]int {
    let result [2][2]int = [2][2]int{[2]int{0, 0}, [2]int{0, 0}}

    result[0][0] = left[0][0] * right[0][0] + left[0][1] * right[1][0]
    result[0][1] = left[0][0] * right[0][1] + left[0][1] * right[1][1]
    result[1][0] = left[1][0] * right[0][0] + left[1][1] * right[1][0]
    result[1][1] = left[1][0] * right[0][1] + left[1][1] * right[1][1]

    return result
}

func multiply2x2Loop(left [2][2]int, right [2][2]int) [2][2]int {
    let result [2][2]int = [2][2]int{[2]int{0, 0}, [2]int{0, 0}}
    let row int = 0

    while row < 2 {
        let col int = 0

        while col < 2 {
            let k int = 0
            let sum int = 0

            while k < 2 {
                sum = sum + left[row][k] * right[k][col]
                k = k + 1
            }

            result[row][col] = sum
            col = col + 1
        }

        row = row + 1
    }

    return result
}

func main() int {
    let a [2][2]int = [2][2]int{[2]int{1, 2}, [2]int{3, 4}}
    let b [2][2]int = [2][2]int{[2]int{5, 6}, [2]int{7, 8}}
    let product [2][2]int = multiply2x2(a, b)
    let looped [2][2]int = multiply2x2Loop(a, b)

    print(product[0][0], " ", product[0][1])
    print(product[1][0], " ", product[1][1])
    print(looped[0][0], " ", looped[0][1])
    print(looped[1][0], " ", looped[1][1])
    return 0
}
