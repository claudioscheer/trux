package handlers

import "http"

type UserView struct {
  id string
  authUser string
  role string
}

func formatUserJson(u *UserView) string {
  return "{\"id\":\"" + u.id + "\",\"auth_user\":\"" + u.authUser + "\",\"role\":\"" + u.role + "\"}\n"
}

pub func getUser(request int) int {
  let view UserView = UserView{
    id: http.param(request, "id"),
    authUser: http.context(request, "userId"),
    role: http.context(request, "role"),
  }
  http.json(request, 200, formatUserJson(&view))
  return 0
}

pub func updateUser(request int) int {
  let id string = http.param(request, "id")
  let body string = http.body(request)
  let resp string = "{\"updated_id\":\"" + id + "\",\"payload\":" + body + "}\n"
  http.json(request, 200, resp)
  return 0
}
