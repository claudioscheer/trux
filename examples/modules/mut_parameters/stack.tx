package stack

pub func push(mut xs list[int], value int) int {
  append(xs, value)
  return len(xs)
}

pub func setMiddle(mut xs [3]int, value int) int {
  xs[1] = value
  return xs[1]
}

pub func setFirst(mut xs []int, value int) int {
  xs[0] = value
  return xs[0]
}

pub func bump(mut counts map[string]int, key string) int {
  let current int, ok bool = counts[key]
  if ok {
    counts[key] = current + 1
  } else {
    counts[key] = 1
  }
  return counts[key]
}
