package main

type Matrix2x2 struct {
  cells[2][2]int
}

func multiply2x2(left Matrix2x2, right Matrix2x2) Matrix2x2 {
  let result [2][2]int = [2][2]int{[2]int{0, 0}, [2]int{0, 0}}

  result[0][0] = left.cells[0][0]*right.cells[0][0] + left.cells[0][1]*right.cells[1][0]
  result[0][1] = left.cells[0][0]*right.cells[0][1] + left.cells[0][1]*right.cells[1][1]
  result[1][0] = left.cells[1][0]*right.cells[0][0] + left.cells[1][1]*right.cells[1][0]
  result[1][1] = left.cells[1][0]*right.cells[0][1] + left.cells[1][1]*right.cells[1][1]

  return Matrix2x2{cells: result}
}

func multiply2x2Loop(left *Matrix2x2, right *Matrix2x2) Matrix2x2 {
  let result [2][2]int = [2][2]int{[2]int{0, 0}, [2]int{0, 0}}

  for let row int = 0; row < 2; row = row + 1 {
    for let col int = 0; col < 2; col = col + 1 {
      let sum int = 0

      for let k int = 0; k < 2; k = k + 1 {
        sum = sum + left.cells[row][k]*right.cells[k][col]
      }

      result[row][col] = sum
    }
  }

  return Matrix2x2{cells: result}
}

func main() int {
  let a Matrix2x2 = Matrix2x2{cells: [2][2]int{[2]int{1, 2}, [2]int{3, 4}}}
  let b Matrix2x2 = Matrix2x2{cells: [2][2]int{[2]int{5, 6}, [2]int{7, 8}}}
  let product Matrix2x2 = multiply2x2(a, b)
  let looped Matrix2x2 = multiply2x2Loop(&a, &b)

  print(product.cells[0][0], " ", product.cells[0][1])
  print(product.cells[1][0], " ", product.cells[1][1])
  print(looped.cells[0][0], " ", looped.cells[0][1])
  print(looped.cells[1][0], " ", looped.cells[1][1])
  return 0
}
