package main

func main() int {
    let xs [4]int = [4]int{1, 2, 3, 4}
    let ys []int = xs[1:3]
    ys[0] = 8
    print(xs[1], " ", ys[0], " ", len(ys))

    let zs []int = make([]int, 3)
    zs[0] = 5
    zs[2] = 7
    print(zs[0], " ", zs[1], " ", zs[2])

    let text string = "kern"
    print(text[1], " ", text[1:3], " ", len(text))

    return 0
}
