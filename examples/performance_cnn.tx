package main

import "gpu"
import "time"

// conv3 is one convolution plus ReLU.
//
// The image is a flat stack of channels:
//
//   value(channel, y, x) = buffer[((channel * height) + y) * width + x]
//
// The 3x3 weights are packed the same way, with the kernel row and column
// last. i is the output element from gpu.launch1d. The thread turns that
// single index back into channel, y, and x. Neighbor taps that fall outside
// the image contribute nothing.
kernel func conv3(i int, input gpu.Buffer[float], weight gpu.Buffer[float], output gpu.Buffer[float], width int, height int, inCh int, outCh int) {
  let spatial int = width * height
  let oc int = i / spatial
  let rem int = i - oc * spatial
  let y int = rem / width
  let x int = rem - y * width
  let sum float = 0.0

  for let ic int = 0; ic < inCh; ic = ic + 1 {
    for let ky int = 0; ky < 3; ky = ky + 1 {
      for let kx int = 0; kx < 3; kx = kx + 1 {
        let iy int = y + ky - 1
        let ix int = x + kx - 1
        if iy >= 0 && iy < height && ix >= 0 && ix < width {
          let inIndex int = (ic * height + iy) * width + ix
          let wIndex int = ((oc * inCh + ic) * 3 + ky) * 3 + kx
          sum = sum + input[inIndex] * weight[wIndex]
        }
      }
    }
  }

  if sum < 0.0 {
    sum = 0.0
  }
  output[i] = sum
}

// conv3Cpu is the same layer as conv3. The loop order matches the index
// unpacking in the kernel, so each output uses the same multiplies.
func conv3Cpu(input []float, weight []float, mut output []float, width int, height int, inCh int, outCh int) int {
  for let oc int = 0; oc < outCh; oc = oc + 1 {
    for let y int = 0; y < height; y = y + 1 {
      for let x int = 0; x < width; x = x + 1 {
        let sum float = 0.0

        for let ic int = 0; ic < inCh; ic = ic + 1 {
          for let ky int = 0; ky < 3; ky = ky + 1 {
            for let kx int = 0; kx < 3; kx = kx + 1 {
              let iy int = y + ky - 1
              let ix int = x + kx - 1
              if iy >= 0 && iy < height && ix >= 0 && ix < width {
                let inIndex int = (ic * height + iy) * width + ix
                let wIndex int = ((oc * inCh + ic) * 3 + ky) * 3 + kx
                sum = sum + input[inIndex] * weight[wIndex]
              }
            }
          }
        }

        if sum < 0.0 {
          sum = 0.0
        }
        output[(oc * height + y) * width + x] = sum
      }
    }
  }

  return 0
}

func checksum(values []float) float {
  let total float = 0.0

  for let i int = 0; i < len(values); i = i + 1 {
    total = total + values[i]
  }

  return total
}

func mismatchCount(cpu []float, gpu []float) int {
  let mismatches int = 0

  for let i int = 0; i < len(cpu); i = i + 1 {
    let diff float = cpu[i] - gpu[i]
    if diff < 0.0 {
      diff = 0.0 - diff
    }
    if diff > 0.000001 {
      mismatches = mismatches + 1
    }
  }

  return mismatches
}

func printSeconds(label string, nanos int) int {
  let seconds int = nanos / 1000000000
  let remainder int = nanos - seconds * 1000000000
  let millis int = remainder / 1000000

  if millis < 10 {
    print(label, seconds, ".00", millis, " s")
  } else if millis < 100 {
    print(label, seconds, ".0", millis, " s")
  } else {
    print(label, seconds, ".", millis, " s")
  }

  return 0
}

// fillFloat writes a repeating ramp. Trux has no int-to-float cast, so the
// pattern is built with float addition.
func fillFloat(mut values []float, step float, limit float) int {
  let cursor float = step

  for let i int = 0; i < len(values); i = i + 1 {
    values[i] = cursor
    cursor = cursor + step
    if cursor > limit {
      cursor = step
    }
  }

  return 0
}

func main() int {
  // Four 3x3 convolutions on one grayscale image. ReLU is inside conv3.
  // Channels: 1 -> 16 -> 32 -> 32 -> 16. Weights are fixed, so this measures
  // inference, not training.
  let width int = 384
  let height int = 384
  let c16 int = 16
  let c32 int = 32
  let pixels int = width * height
  let n16 int = c16 * pixels
  let n32 int = c32 * pixels

  let image []float = make([]float, pixels)
  let w1 []float = make([]float, 3 * 3 * 1 * c16)
  let w2 []float = make([]float, 3 * 3 * c16 * c32)
  let w3 []float = make([]float, 3 * 3 * c32 * c32)
  let w4 []float = make([]float, 3 * 3 * c32 * c16)
  let cpuA []float = make([]float, n16)
  let cpuB []float = make([]float, n32)
  let cpuC []float = make([]float, n32)
  let cpuOut []float = make([]float, n16)
  let gpuOut []float = make([]float, n16)

  fillFloat(image, 0.05, 1.0)
  fillFloat(w1, 0.02, 0.2)
  fillFloat(w2, 0.015, 0.15)
  fillFloat(w3, 0.01, 0.1)
  fillFloat(w4, 0.012, 0.12)

  let cpuStart int = time.monotonicNanos()
  conv3Cpu(image, w1, cpuA, width, height, 1, c16)
  conv3Cpu(cpuA, w2, cpuB, width, height, c16, c32)
  conv3Cpu(cpuB, w3, cpuC, width, height, c32, c32)
  conv3Cpu(cpuC, w4, cpuOut, width, height, c32, c16)
  let cpuEnd int = time.monotonicNanos()

  let gpuStart int = time.monotonicNanos()
  let dImage gpu.Buffer[float] = gpu.from(image)
  let dW1 gpu.Buffer[float] = gpu.from(w1)
  let dW2 gpu.Buffer[float] = gpu.from(w2)
  let dW3 gpu.Buffer[float] = gpu.from(w3)
  let dW4 gpu.Buffer[float] = gpu.from(w4)
  let dA gpu.Buffer[float] = gpu.alloc(n16)
  let dB gpu.Buffer[float] = gpu.alloc(n32)
  let dC gpu.Buffer[float] = gpu.alloc(n32)
  let dOut gpu.Buffer[float] = gpu.alloc(n16)

  gpu.launch1d(conv3, n16, dImage, dW1, dA, width, height, 1, c16)
  gpu.launch1d(conv3, n32, dA, dW2, dB, width, height, c16, c32)
  gpu.launch1d(conv3, n32, dB, dW3, dC, width, height, c32, c32)
  gpu.launch1d(conv3, n16, dC, dW4, dOut, width, height, c32, c16)
  gpu.sync()
  gpu.to(dOut, gpuOut)
  let gpuEnd int = time.monotonicNanos()

  print("width ", width)
  print("height ", height)
  print("layers 4")
  print("channels 1 16 32 32 16")
  print("cpu checksum ", checksum(cpuOut))
  print("gpu checksum ", checksum(gpuOut))
  print("mismatches ", mismatchCount(cpuOut, gpuOut))
  printSeconds("cpu seconds ", cpuEnd - cpuStart)
  printSeconds("gpu seconds ", gpuEnd - gpuStart)

  gpu.free(dImage)
  gpu.free(dW1)
  gpu.free(dW2)
  gpu.free(dW3)
  gpu.free(dW4)
  gpu.free(dA)
  gpu.free(dB)
  gpu.free(dC)
  gpu.free(dOut)

  return 0
}
