package main

// A tiny helper keeps the example focused on the full call pipeline:
// parse a function, type-check its parameters, call it, and print the result.
func add(a int, b int) int {
    return a + b
}

func main() int {
    // Variables use explicit types so the compiler never has to infer `x`.
    let x int = add(1, 2)

    // `print` accepts one or more scalar values and writes a newline.
    print(x)

    return 0
}
