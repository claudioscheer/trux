package queue

pub type Queue struct {
  values list[int]
  head int
}

// Enqueue grows the caller-owned Queue through a pointer.
pub func enqueue(q *Queue, value int) int {
  append(q.values, value)
  return len(q.values)
}

// Dequeue advances the Queue's head index.
pub func dequeue(q *Queue) int {
  let value int = q.values[q.head]
  q.head = q.head + 1
  return value
}

pub func queued(q *Queue) int {
  return len(q.values) - q.head
}
