package main

func main() int {
    let name string = read_line()
    let bonus int = read_int()

    let note string = read_file("examples/io_input.txt")
    write_file("examples/io_copy.txt", note + "\n" + name)

    let cells list[string] = read_csv("examples/io_input.csv", 2)
    append(cells, name)
    append(cells, "interactive")
    write_csv("examples/io_output.csv", cells, 2)

    print("hello ", name)
    print(bonus + 1)
    print(len(cells), " ", cells[0], " ", cells[1])

    return 0
}
