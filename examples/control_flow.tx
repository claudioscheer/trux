package main

func main() int {
  let x int = 10

  // Conditions must be bool values. Numeric truthiness is intentionally
  // rejected so generated C does not inherit C's loose condition rules.
  if x > 10 {
    print("huge")
  } else if x > 5 {
    print("big")
  } else {
    print("small")
  }

  // Assignment updates an existing variable and keeps its original type.
  let i int = 0
  for i < 3 {
    print(i)
    i = i + 1
  }

  if i == 3 {
    print("done")
  }

  return 0
}
