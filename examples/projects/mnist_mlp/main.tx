package main

import "gpu"
import "time"

// dense computes one element of a fully connected layer.
//
// weight is [outDim, inDim] row-major, so the inner loop walks the weight row
// and the input row in the same order. relu is 1 for the hidden layers and 0
// for the output layer; the softmax that would follow is not needed because
// the highest logit is also the highest probability.
kernel func dense(i int, input gpu.Buffer [float], weight gpu.Buffer [float], bias gpu.Buffer [float], out gpu.Buffer [float], inDim int, outDim int, relu int) {
  let row int = i / outDim
  let oc int = i - row * outDim
  let sum float = bias[oc]
  let base int = row * inDim
  let weightBase int = oc * inDim

  for let k int = 0; k < inDim; k = k + 1 {
    sum = sum + weight[weightBase + k] *input[base + k]
  }

  if relu == 1 && sum < 0.0 {
    sum = 0.0
  }

  out[i] = sum
}

func main() int {
  gpu.mount("model.txm")

  let rows int = gpu.dim("test_images", 0)
  let features int = gpu.dim("test_images", 1)
  let hidden1 int = gpu.dim("b1", 0)
  let hidden2 int = gpu.dim("b2", 0)
  let classes int = gpu.dim("b3", 0)

  if rows < 1 {
    print("model has no test rows")
    return 1
  }

  let h1 gpu.Buffer[float] = gpu.alloc(rows *hidden1)
  let h2 gpu.Buffer[float] = gpu.alloc(rows *hidden2)
  let logits gpu.Buffer[float] = gpu.alloc(rows *classes)

  // The whole test set, three launches: 784 -> hidden1 -> hidden2 -> classes.
  let started int = time.monotonicNanos()
  gpu.launch1d(dense, rows *hidden1, gpu.floats("test_images"), gpu.floats("w1"), gpu.floats("b1"), h1, features, hidden1, 1)
  gpu.launch1d(dense, rows *hidden2, h1, gpu.floats("w2"), gpu.floats("b2"), h2, hidden1, hidden2, 1)
  gpu.launch1d(dense, rows *classes, h2, gpu.floats("w3"), gpu.floats("b3"), logits, hidden2, classes, 0)
  gpu.sync()

  let scores []float = make([]float, rows *classes)
  gpu.to(logits, scores)
  let finished int = time.monotonicNanos()
  let labels []int = gpu.hostInts("test_labels")
  let expectedPredictions []int = gpu.hostInts("expected_predictions")
  let expectedLogits []float = gpu.hostFloats("expected_logits")

  let errors int = 0
  let expectedErrors int = 0
  let mismatches int = 0
  let maxDiff float = 0.0
  let outside int = 0
  let correct float = 0.0
  let total float = 0.0

  for let r int = 0; r < rows; r = r + 1 {
    let best float = scores[r * classes]
    let digit int = 0

    for let c int = 1; c < classes; c = c + 1 {
      let value float = scores[r * classes + c]
      if value > best {
        best = value
        digit = c
      }
    }

    // Compare every value the last layer produced, not only its argmax.
    // 1e-9 is well above the 1.8e-14 rounding here and well below any real
    // weight or layout error.
    for let c int = 0; c < classes; c = c + 1 {
      let diff float = scores[r * classes + c] - expectedLogits[r * classes + c]
      if diff < 0.0 {
        diff = 0.0 - diff
      }
      if diff > maxDiff {
        maxDiff = diff
      }
      if diff > 0.000000001 {
        outside = outside + 1
      }
    }

    total = total + 1.0
    if digit == labels[r]{
      correct = correct + 1.0
    } else {
      if errors < 5 {
        print("row ", r, " predicted ", digit, " want ", labels[r])
      }
      errors = errors + 1
    }

    if expectedPredictions[r] != labels[r]{
      expectedErrors = expectedErrors + 1
    }

    if digit != expectedPredictions[r]{
      if mismatches < 5 {
        print("row ", r, " trux ", digit, " python ", expectedPredictions[r])
      }
      mismatches = mismatches + 1
    }
  }

  gpu.free(h1)
  gpu.free(h2)
  gpu.free(logits)

  print("rows ", rows)
  print("errors ", errors)
  print("expected errors ", expectedErrors)
  print("predictions mismatched ", mismatches)
  print("logits compared ", rows *classes)
  print("max logit difference ", maxDiff)
  print("logits outside 1e-9 ", outside)
  print("accuracy ", correct / total)
  print("millis ", (finished - started) / 1000000)

  if mismatches != 0 {
    print("Trux and the exporter disagree on these predictions")
    return 1
  }

  if outside != 0 {
    print("Trux and the exporter disagree on the last layer")
    return 1
  }

  return 0
}
