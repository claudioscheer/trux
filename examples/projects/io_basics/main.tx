package main

func main() int {
  let name string = readLine()
  let bonus int = readInt()

  let note string = readFile("examples/projects/io_basics/input.txt")
  writeFile("examples/projects/io_basics/copy.txt", note + "\n" + name)

  let cells list[string] = readCsv("examples/projects/io_basics/input.csv", 2)
  append(cells, name)
  append(cells, "interactive")
  writeCsv("examples/projects/io_basics/output.csv", cells, 2)

  print("hello ", name)
  print(bonus + 1)
  print(len(cells), " ", cells[0], " ", cells[1])

  return 0
}
