package middleware

import "http"

type Session struct {
  userId string
  role string
}

pub func authenticate(request int) int {
  let sessions map[string]Session = map[string]Session{
    "Bearer secret-token": Session{userId: "user-42", role: "admin"},
  }
  let token string = http.header(request, "Authorization")
  let session Session, ok bool = sessions[token]
  if ok {
    http.set(request, "userId", session.userId)
    http.set(request, "role", session.role)
    return 0
  }
  http.setHeader(request, "WWW-Authenticate", "Bearer")
  http.json(request, 401, "{\"error\":\"unauthorized\"}\n")
  return 1
}

pub func serverHeader(request int) int {
  http.setHeader(request, "X-Server", "trux-uring")
  return 0
}
