package main

func pick(flag bool) int {
  if flag {
    return 42
  } else {
    return 7
  }
}

func firstBig(limit int) int {
  let i int = 0
  for i < limit {
    if i > 3 {
      return i
    }
    i = i + 1
  }

  return 0
}

func main() int {
  print(pick(true))
  print(pick(false))
  print(firstBig(6))
  print(firstBig(3))
  return 0
}
