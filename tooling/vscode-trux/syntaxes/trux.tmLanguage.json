{
  "scopeName": "source.trux",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.trux",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.trux",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.trux"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.trux"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.trux",
              "match": "\\\\[\"\\\\nt]"
            },
            {
              "name": "invalid.illegal.character.escape.trux",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.package.declaration.trux",
          "match": "\\b(package)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.package.trux"
            },
            "2": {
              "name": "entity.name.namespace.trux"
            }
          }
        },
        {
          "name": "meta.import.declaration.trux",
          "match": "\\b(import)\\s+(\"(?:\\\\[\"\\\\nt]|[^\"\\\\\\r\\n])*\")",
          "captures": {
            "1": {
              "name": "keyword.declaration.import.trux"
            },
            "2": {
              "name": "string.quoted.double.import.trux"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "meta.variable.declaration.trux",
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.trux"
            },
            "2": {
              "name": "variable.other.declaration.trux"
            }
          }
        },
        {
          "name": "variable.parameter.trux",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s+(?:\\[[0-9]*\\]|list\\s*\\[|int\\b|float\\b|string\\b|bool\\b))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.trux",
          "match": "\\b(?:(pub|kernel)\\s+)?(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.visibility.trux"
            },
            "2": {
              "name": "keyword.declaration.function.trux"
            },
            "3": {
              "name": "entity.name.function.trux"
            }
          }
        },
        {
          "name": "support.function.builtin.trux",
          "match": "\\b(print|len|clone|append|make)(?=\\s*\\()"
        },
        {
          "name": "meta.function-call.qualified.trux",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.trux"
            },
            "2": {
              "name": "punctuation.accessor.dot.trux"
            },
            "3": {
              "name": "entity.name.function.call.trux"
            }
          }
        },
        {
          "name": "entity.name.function.call.trux",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.trux",
          "match": "\\b(if|else|for|return)\\b"
        },
        {
          "name": "keyword.declaration.trux",
          "match": "\\b(package|import|pub|kernel|let)\\b"
        },
        {
          "name": "keyword.operator.word.trux",
          "match": "\\bin\\b"
        },
        {
          "name": "constant.language.boolean.trux",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.trux",
          "match": "\\b(int|float|string|bool|list)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.trux",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.trux",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.trux",
          "match": "==|!=|<=|>=|[+\\-*/=<>]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.trux",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.trux",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.trux",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.trux",
          "match": ","
        },
        {
          "name": "punctuation.separator.slice.trux",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.trux",
          "match": "\\."
        }
      ]
    }
  }
}
