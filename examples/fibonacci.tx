package main

func fibRecursive(n int) int {
  // Recursive calls work like any other resolved function call.
  if n <= 1 {
    return n
  }

  return fibRecursive(n - 1) + fibRecursive(n - 2)
}

func printIterative(count int) int {
  let i int = 0
  let a int = 0
  let b int = 1

  // The loop version demonstrates mutable locals without recursion.
  while i < count {
    print(a)

    let next int = a + b
    a = b
    b = next
    i = i + 1
  }

  return 0
}

func printRecursive(count int) int {
  let i int = 0

  while i < count {
    print(fibRecursive(i))
    i = i + 1
  }

  return 0
}

func main() int {
  let count int = 10

  print("iterative")
  printIterative(count)

  print("recursive")
  printRecursive(count)

  return 0
}
